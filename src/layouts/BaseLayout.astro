---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'collection // zDiqim7' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname.replace(/\/$/, '');

const navItems = [
  { label: 'index', href: `${base || '/'}` },
  { label: 'walls', href: `${base}/walls` },
  { label: 'links', href: `${base}/links` },
  { label: 'docs', href: `${base}/docs` },
];
---

<!doctype html>
<html lang="id" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <!-- Cegah kedipan layar putih saat reload di dark mode -->
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>

  <body class="min-h-screen flex flex-col bg-zinc-50 text-zinc-900 dark:bg-[#09090b] dark:text-zinc-100 transition-colors duration-300 selection:bg-yellow-300 selection:text-zinc-950">
    <!-- Custom Animated Cursor (Desktop Only) -->
    <div
      id="cursor-ring"
      class="hidden pointer-events-none fixed top-0 left-0 z-50 w-8 h-8 -ml-4 -mt-4 rounded-full border border-purple-500/70 dark:border-yellow-400/70 transition-[width,height,margin,border-color,background-color] duration-200 ease-out"
    ></div>
    <div
      id="cursor-dot"
      class="hidden pointer-events-none fixed top-0 left-0 z-50 w-1.5 h-1.5 -ml-[3px] -mt-[3px] rounded-full bg-yellow-500 dark:bg-purple-400"
    ></div>

    <!-- Architectural Background Layers (Ala Hexaa & Antislop) -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
      <!-- Ambient Yellow & Purple Radial Glow -->
      <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-purple-500/10 dark:bg-purple-600/15 blur-3xl"></div>
      <div class="absolute top-1/3 -right-32 w-96 h-96 rounded-full bg-yellow-400/15 dark:bg-yellow-500/10 blur-3xl"></div>

      <!-- Topographic Contour Lines SVG -->
      <svg
        class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[1100px] max-w-none h-[420px] text-zinc-900/[0.04] dark:text-white/[0.04]"
        viewBox="0 0 1000 400"
        fill="none"
      >
        <ellipse cx="500" cy="360" rx="140" ry="55" stroke="currentColor" stroke-width="1" />
        <ellipse cx="500" cy="360" rx="230" ry="95" stroke="currentColor" stroke-width="1" />
        <ellipse cx="500" cy="360" rx="330" ry="140" stroke="currentColor" stroke-width="1" />
        <ellipse cx="500" cy="360" rx="440" ry="190" stroke="currentColor" stroke-width="1" />
        <ellipse cx="500" cy="360" rx="560" ry="245" stroke="currentColor" stroke-width="1" />
        <ellipse cx="500" cy="360" rx="690" ry="305" stroke="currentColor" stroke-width="1" />
      </svg>

      <!-- Architectural Frame Guide Rails + Crosshairs -->
      <div class="max-w-6xl mx-auto h-full px-3 sm:px-6 relative">
        <div class="w-full h-full border-x border-zinc-200/80 dark:border-zinc-800/70 relative">
          <!-- Top Crosshairs -->
          <span class="absolute top-16 -left-[4.5px] font-mono text-[10px] leading-none text-zinc-400 dark:text-zinc-600">+</span>
          <span class="absolute top-16 -right-[4.5px] font-mono text-[10px] leading-none text-zinc-400 dark:text-zinc-600">+</span>
          <!-- Bottom Crosshairs -->
          <span class="absolute bottom-14 -left-[4.5px] font-mono text-[10px] leading-none text-zinc-400 dark:text-zinc-600">+</span>
          <span class="absolute bottom-14 -right-[4.5px] font-mono text-[10px] leading-none text-zinc-400 dark:text-zinc-600">+</span>
        </div>
      </div>
    </div>

    <!-- Top Navbar -->
    <header class="sticky top-0 z-40 border-b border-zinc-200/80 dark:border-zinc-800/70 bg-zinc-50/80 dark:bg-[#09090b]/80 backdrop-blur-md">
      <div class="max-w-6xl mx-auto px-4 sm:px-8 h-16 flex items-center justify-between gap-2">
        <!-- Brand -->
        <a
          href={base || '/'}
          class="font-mono text-xs sm:text-sm font-semibold tracking-tight flex items-center gap-2 shrink-0"
        >
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-yellow-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-gradient-to-tr from-yellow-400 to-purple-500"></span>
          </span>
          <span>zDiqim7<span class="text-zinc-400 dark:text-zinc-500">/collection</span></span>
        </a>

        <!-- Floating Pill Navigation (Responsive) -->
        <nav class="flex items-center p-1 rounded-full border border-zinc-200 dark:border-zinc-800 bg-white/90 dark:bg-zinc-900/90 shadow-xs overflow-x-auto max-w-[58vw] sm:max-w-none">
          {navItems.map((item) => {
            const isActive = currentPath === item.href.replace(/\/$/, '');
            return (
              <a
                href={item.href}
                class:list={[
                  'px-3 py-1 rounded-full font-mono text-xs transition-all whitespace-nowrap',
                  isActive
                    ? 'bg-zinc-900 text-yellow-300 dark:bg-zinc-100 dark:text-zinc-950 font-semibold shadow-xs'
                    : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-zinc-100',
                ]}
              >
                {item.label}
              </a>
            );
          })}
        </nav>

        <!-- Theme Toggle Button (Top Right) -->
        <button
          id="theme-toggle"
          type="button"
          aria-label="Toggle Dark or Light Mode"
          class="w-9 h-9 rounded-full border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 flex items-center justify-center text-zinc-700 dark:text-zinc-300 hover:border-purple-500 dark:hover:border-yellow-400 transition-colors shrink-0"
        >
          <!-- Sun Icon (muncul saat Dark Mode) -->
          <svg class="hidden dark:block w-4 h-4 text-yellow-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
          </svg>
          <!-- Moon Icon (muncul saat Light Mode) -->
          <svg class="block dark:hidden w-4 h-4 text-purple-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </button>
      </div>
    </header>

    <!-- Main Content -->
    <main class="relative z-10 flex-1 max-w-5xl w-full mx-auto px-5 sm:px-8 py-8 sm:py-12">
      <slot />
    </main>

    <!-- Bottom Status Bar (Ala Hexaa.sh) -->
    <footer class="relative z-10 border-t border-zinc-200/80 dark:border-zinc-800/70">
      <div class="max-w-6xl mx-auto px-4 sm:px-8 h-14 flex items-center justify-between font-mono text-xs text-zinc-500">
        <div class="flex items-center gap-3">
          <span id="live-clock" class="text-zinc-700 dark:text-zinc-300">[--:--]</span>
          <span class="hidden sm:inline">· static archive · no db</span>
        </div>

        <!-- Mini Yellow & Purple Geometric Shapes Badge -->
        <div class="flex items-center gap-1" title="yellow & purple accent">
          <span class="w-2.5 h-2.5 rounded-full bg-yellow-400"></span>
          <span class="w-2.5 h-2.5 rounded-xs bg-purple-500"></span>
          <span class="w-2.5 h-2.5 rotate-45 bg-yellow-400/80 scale-75"></span>
          <span class="w-2.5 h-2.5 rounded-full border border-purple-500"></span>
        </div>
      </div>
    </footer>

    <!-- Interactive Scripts: Theme Toggle, Live Clock, Custom Cursor -->
    <script is:inline>
      // 1. Theme Toggle
      const themeBtn = document.getElementById('theme-toggle');
      themeBtn?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });

      // 2. Live Clock
      const clockEl = document.getElementById('live-clock');
      function updateClock() {
        if (!clockEl) return;
        const now = new Date();
        clockEl.textContent = `[${now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' })}]`;
      }
      updateClock();
      setInterval(updateClock, 15000);

      // 3. Smooth Custom Cursor (Desktop Pointer Only)
      if (window.matchMedia('(pointer: fine)').matches) {
        const ring = document.getElementById('cursor-ring');
        const dot = document.getElementById('cursor-dot');

        if (ring && dot) {
          document.body.classList.add('custom-cursor-active');
          ring.classList.remove('hidden');
          dot.classList.remove('hidden');

          let mouseX = window.innerWidth / 2;
          let mouseY = window.innerHeight / 2;
          let ringX = mouseX;
          let ringY = mouseY;

          window.addEventListener('mousemove', (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;
            dot.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0)`;
          });

          function animateRing() {
            ringX += (mouseX - ringX) * 0.18;
            ringY += (mouseY - ringY) * 0.18;
            ring.style.transform = `translate3d(${ringX}px, ${ringY}px, 0)`;
            requestAnimationFrame(animateRing);
          }
          requestAnimationFrame(animateRing);

          // Efek morph saat hover tombol / link / kartu
          const interactiveTargets = document.querySelectorAll('a, button, .choose-card');
          interactiveTargets.forEach((el) => {
            el.addEventListener('mouseenter', () => {
              ring.classList.add('w-11', 'h-11', '-ml-[22px]', '-mt-[22px]', 'bg-yellow-400/10', 'dark:bg-purple-500/15');
              ring.classList.remove('w-8', 'h-8', '-ml-4', '-mt-4');
            });
            el.addEventListener('mouseleave', () => {
              ring.classList.remove('w-11', 'h-11', '-ml-[22px]', '-mt-[22px]', 'bg-yellow-400/10', 'dark:bg-purple-500/15');
              ring.classList.add('w-8', 'h-8', '-ml-4', '-mt-4');
            });
          });
        }
      }
    </script>
  </body>
</html>