---
import BaseLayout from '../layouts/BaseLayout.astro';
import { parseLinks } from '../lib/links';

const linksRaw = import.meta.glob('../../links/links.md', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const rawContent = (Object.values(linksRaw)[0] as string) || '';

interface LinkItem {
  title: string;
  url: string;
  desc: string;
  category: string;
}

const items = parseLinks(rawContent);

const categories = ['All', ...Array.from(new Set(items.map((i) => i.category)))];
---

<BaseLayout title="/links — Curated Bookmarks">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
    <div>
      <div class="font-mono text-xs text-purple-600 dark:text-purple-400 mb-1">02 / BOOKMARKS</div>
      <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight">Curated Links</h1>
      <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mt-1">
        Di-parse otomatis dari <code class="text-xs">links/links.md</code>. Tekan <kbd class="px-1.5 py-0.5 rounded border border-zinc-300 dark:border-zinc-700 text-[11px]">/</kbd> untuk cari cepat.
      </p>
    </div>
    <div class="font-mono text-xs px-3 py-1.5 rounded-full border border-zinc-200 dark:border-zinc-800 bg-white/70 dark:bg-zinc-900/70 self-start">
      showing: <span id="visible-count" class="text-purple-600 dark:text-purple-400 font-semibold">{items.length}</span> / {items.length}
    </div>
  </div>

  <!-- Search & Category Filter -->
  <div class="space-y-4 mb-8">
    <input
      id="link-search"
      type="search"
      placeholder="Cari nama tool, kategori, atau deskripsi..."
      class="w-full px-4 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white/90 dark:bg-zinc-900/80 text-sm focus:outline-none focus:border-purple-500 dark:focus:border-yellow-400 transition-colors"
    />

    <div class="flex flex-wrap gap-1.5">
      {categories.map((cat, idx) => (
        <button
          type="button"
          data-cat={cat}
          class:list={[
            'cat-pill px-3 py-1 rounded-full font-mono text-xs border transition-colors',
            idx === 0
              ? 'active bg-zinc-900 text-yellow-300 border-zinc-900 dark:bg-yellow-400 dark:text-zinc-950 dark:border-yellow-400 font-semibold'
              : 'border-zinc-200 dark:border-zinc-800 text-zinc-600 dark:text-zinc-400 hover:border-zinc-400 dark:hover:border-zinc-600',
          ]}
        >
          {cat}
        </button>
      ))}
    </div>
  </div>

  <!-- Links Grid -->
  <div id="links-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {items.map((item) => (
      <a
        href={item.url}
        target="_blank"
        rel="noopener noreferrer"
        data-category={item.category}
        data-search={`${item.title} ${item.desc} ${item.category} ${item.url}`.toLowerCase()}
        class="link-card choose-card group rounded-2xl border border-zinc-200 dark:border-zinc-800/90 bg-white/80 dark:bg-zinc-900/40 hover:bg-white dark:hover:bg-zinc-900/90 p-5 flex flex-col justify-between transition-all"
      >
        <span class="choose-corner choose-tl"></span>
        <span class="choose-corner choose-tr"></span>
        <span class="choose-corner choose-bl"></span>
        <span class="choose-corner choose-br"></span>

        <div>
          <div class="flex items-center justify-between gap-2 mb-2.5">
            <span class="font-mono text-[10px] px-2 py-0.5 rounded-full bg-purple-500/10 text-purple-700 dark:text-purple-300 border border-purple-500/20 truncate">
              {item.category}
            </span>
            <span class="font-mono text-xs text-zinc-400 group-hover:text-amber-500 dark:group-hover:text-yellow-400 transition-colors">
              ↗
            </span>
          </div>
          <h2 class="font-semibold text-sm text-zinc-900 dark:text-zinc-100 group-hover:text-purple-600 dark:group-hover:text-yellow-300 transition-colors">
            {item.title}
          </h2>
          {item.desc && (
            <p class="mt-1.5 text-xs text-zinc-600 dark:text-zinc-400 line-clamp-2 leading-relaxed">
              {item.desc}
            </p>
          )}
        </div>

        <div class="mt-4 pt-2.5 border-t border-zinc-100 dark:border-zinc-800/70 font-mono text-[11px] text-zinc-400 truncate">
          {item.url.replace(/^https?:\/\//, '')}
        </div>
      </a>
    ))}
  </div>

  <script is:inline>
    const searchInput = document.getElementById('link-search');
    const pills = document.querySelectorAll('.cat-pill');
    const cards = document.querySelectorAll('.link-card');
    const countEl = document.getElementById('visible-count');
    let activeCategory = 'All';

    function filterLinks() {
      const q = (searchInput?.value || '').toLowerCase().trim();
      let visible = 0;

      cards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        const haystack = card.getAttribute('data-search') || '';
        const matchCat = activeCategory === 'All' || cat === activeCategory;
        const matchQuery = !q || haystack.includes(q);

        if (matchCat && matchQuery) {
          card.classList.remove('hidden');
          visible++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (countEl) countEl.textContent = String(visible);
    }

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        activeCategory = pill.getAttribute('data-cat') || 'All';
        pills.forEach((p) => {
          p.classList.remove('active', 'bg-zinc-900', 'text-yellow-300', 'border-zinc-900', 'dark:bg-yellow-400', 'dark:text-zinc-950', 'dark:border-yellow-400', 'font-semibold');
          p.classList.add('border-zinc-200', 'dark:border-zinc-800', 'text-zinc-600', 'dark:text-zinc-400');
        });
        pill.classList.add('active', 'bg-zinc-900', 'text-yellow-300', 'border-zinc-900', 'dark:bg-yellow-400', 'dark:text-zinc-950', 'dark:border-yellow-400', 'font-semibold');
        pill.classList.remove('border-zinc-200', 'dark:border-zinc-800', 'text-zinc-600', 'dark:text-zinc-400');
        filterLinks();
      });
    });

    searchInput?.addEventListener('input', filterLinks);
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== searchInput) {
        e.preventDefault();
        searchInput?.focus();
      }
    });
  </script>
</BaseLayout>